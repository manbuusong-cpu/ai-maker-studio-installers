; Conservative per-user running-app guard. No process termination or elevation.
; Directory/exclusion/PID cross the native boundary only as process environment data.
!ifndef AI_MAKER_APP_RUNNING_GUARD_INCLUDED
!define AI_MAKER_APP_RUNNING_GUARD_INCLUDED
!if ${NSIS_MAX_STRLEN} < 8192
  !error "AI Maker running-app guard requires the pinned 8192-character NSIS build."
!endif

!macro customCheckAppRunning
  Push $0
  Push $1
  System::Call 'kernel32::GetCurrentProcessId() i.r1'
  StrCmp $1 0 aiMakerGuardFailure
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_ROOT", w "$INSTDIR") i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_EXCLUDE", w "$INSTDIR\${UNINSTALL_FILENAME}") i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_PID", w "$1") i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  nsExec::Exec /TIMEOUT=30000 '"$PowerShellPath" -NoLogo -NoProfile -NonInteractive -EncodedCommand '
  Pop $1
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_ROOT", p0) i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_EXCLUDE", p0) i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  System::Call 'kernel32::SetEnvironmentVariableW(w "AI_MAKER_NSIS_GUARD_PID", p0) i.r0'
  StrCmp $0 0 aiMakerGuardFailure
  StrCmp $1 "timeout" aiMakerGuardTimeout
  StrCmp $1 "error" aiMakerGuardLaunchFailure
  StrCmp $1 "0" aiMakerGuardDone
  StrCmp $1 "10" aiMakerGuardRunning aiMakerGuardFailure

  aiMakerGuardRunning:
    DetailPrint "Application is running. Close it before continuing."
    MessageBox MB_OK|MB_ICONEXCLAMATION "Close AI Maker Studio before installing or uninstalling, then try again." /SD IDOK
    SetErrorLevel 10
    Quit

  aiMakerGuardTimeout:
    DetailPrint "Running-application verification exceeded its 30-second limit; no files were removed."
    SetErrorLevel 21
    Quit

  aiMakerGuardLaunchFailure:
    DetailPrint "Running-application verifier could not start; no files were removed."
    SetErrorLevel 22
    Quit

  aiMakerGuardFailure:
    DetailPrint "Running-application verification failed; no files were removed."
    MessageBox MB_OK|MB_ICONEXCLAMATION "Windows could not verify that AI Maker Studio is closed. No files were removed. Try again after closing the application." /SD IDOK
    SetErrorLevel 20
    Quit

  aiMakerGuardDone:
    Pop $1
    Pop $0
!macroend
!endif
